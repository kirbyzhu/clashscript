# =============================================================================
# claude-code.list  —— Claude Code / Anthropic 专用分流规则集
# Format     Clash / Mihomo rule-provider (format: text)
# Behavior   classical
# Source     github.com/kirbyzhu/clashscript
# Version    2026.11.21-r2
# Purpose    将 Claude Code 及 Anthropic 链路独立分流至 dmit 美西出口
# -----------------------------------------------------------------------------
# 说明
#   1. 在 Script buildRules() 中位于放行区之后、通用拦截(ls-reject /
#      category-ads-all)之前引用，避免 statsig.anthropic.com 与专属上报端点
#      被广告拦截名单短路拒绝。
#   2. Anthropic / Claude 自有域名、CDN、IP 段与 ASN 全系统走 dmit，覆盖 CLI、
#      浏览器 OAuth 登录、Chrome 扩展桥接与桌面端。
#   3. 海外伴生依赖与共享日志端点通过 OR(PROCESS-NAME,claude | IN-NAME,claude-in)
#      限定，仅匹配 claude 原生进程及经 127.0.0.1:7891 专用代理入口的 Claude Code
#      子进程(git/node/npm/npx/MCP)，不影响其他应用的广告拦截与分流。
# =============================================================================

# ---------------------------------------------------------------------
# 1. Statsig 显式放行 (ls-reject 含 +.statsig.anthropic.com)
# ---------------------------------------------------------------------
DOMAIN,statsig.anthropic.com

# ---------------------------------------------------------------------
# 2. Anthropic / Claude 自有域名与 CDN
# ---------------------------------------------------------------------
DOMAIN-SUFFIX,anthropic.com
DOMAIN-SUFFIX,claude.ai
DOMAIN-SUFFIX,claude.com
DOMAIN-SUFFIX,claudeusercontent.com
DOMAIN-SUFFIX,claudemcpclient.com
DOMAIN-SUFFIX,clau.de
DOMAIN,servd-anthropic-website.b-cdn.net
DOMAIN,anthropic.com.cdn.cloudflare.net
DOMAIN,anthropic-com.ghost.io

# ---------------------------------------------------------------------
# 3. Anthropic 官方 IP 段与 ASN
# ---------------------------------------------------------------------
IP-CIDR,160.79.104.0/21,no-resolve
IP-CIDR6,2607:6bc0::/32,no-resolve
IP-ASN,399358,no-resolve

# ---------------------------------------------------------------------
# 4. Claude Code 专属错误上报端点 (主机级精确放行)
# ---------------------------------------------------------------------
DOMAIN,o1158394.ingest.us.sentry.io
DOMAIN,o1158394.ingest.sentry.io

# ---------------------------------------------------------------------
# 5. Claude Code 进程及专用入口(claude-in)海外伴生依赖与共享上报端点
# ---------------------------------------------------------------------
AND,((OR,((PROCESS-NAME,claude),(IN-NAME,claude-in))),(DOMAIN,storage.googleapis.com))
AND,((OR,((PROCESS-NAME,claude),(IN-NAME,claude-in))),(DOMAIN-SUFFIX,statsig.com))
AND,((OR,((PROCESS-NAME,claude),(IN-NAME,claude-in))),(DOMAIN-SUFFIX,statsigapi.net))
AND,((OR,((PROCESS-NAME,claude),(IN-NAME,claude-in))),(DOMAIN-SUFFIX,featuregates.org))
AND,((OR,((PROCESS-NAME,claude),(IN-NAME,claude-in))),(DOMAIN-SUFFIX,sentry.io))
AND,((OR,((PROCESS-NAME,claude),(IN-NAME,claude-in))),(DOMAIN-SUFFIX,datadoghq.com))
AND,((OR,((PROCESS-NAME,claude),(IN-NAME,claude-in))),(DOMAIN-SUFFIX,npmjs.org))
AND,((OR,((PROCESS-NAME,claude),(IN-NAME,claude-in))),(DOMAIN-SUFFIX,npmjs.com))
AND,((OR,((PROCESS-NAME,claude),(IN-NAME,claude-in))),(DOMAIN-SUFFIX,ghcr.io))
AND,((OR,((PROCESS-NAME,claude),(IN-NAME,claude-in))),(DOMAIN-SUFFIX,github.com))
AND,((OR,((PROCESS-NAME,claude),(IN-NAME,claude-in))),(DOMAIN-SUFFIX,githubusercontent.com))
AND,((OR,((PROCESS-NAME,claude),(IN-NAME,claude-in))),(DOMAIN-SUFFIX,cloudflare.com))
AND,((OR,((PROCESS-NAME,claude),(IN-NAME,claude-in))),(DOMAIN-SUFFIX,auth0.com))
