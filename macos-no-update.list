rules:
  # === 进程级拦截 (macOS 系统更新相关核心进程) ===
  - PROCESS-NAME,softwareupdated,REJECT
  - PROCESS-NAME,mobileassetd,REJECT

  # === 域名精确匹配 (包含检测、验证、分流节点) ===
  - DOMAIN,swscan.apple.com,REJECT
  - DOMAIN,swdist.apple.com,REJECT
  - DOMAIN,swcdn.apple.com,REJECT
  - DOMAIN,swdownload.apple.com,REJECT
  - DOMAIN,swpost.apple.com,REJECT
  - DOMAIN,gdmf.apple.com,REJECT
  - DOMAIN,mesu.apple.com,REJECT
  - DOMAIN,xp.apple.com,REJECT
  - DOMAIN,gg.apple.com,REJECT
  - DOMAIN,gnosis.apple.com,REJECT

  # === 域名后缀匹配 (包含更新文件 CDN 分发节点) ===
  - DOMAIN-SUFFIX,updates.cdn-apple.com,REJECT
  - DOMAIN-SUFFIX,updates-http.cdn-apple.com,REJECT

  # === 域名关键字匹配 (包含固件及更新资源下载特征) ===
  - DOMAIN-KEYWORD,appldnld,REJECT
